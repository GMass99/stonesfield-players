<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ metaDescription }}">
  <link rel="canonical" href="{{ meta.url }}{{ page.url }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ metaDescription }}">
  <meta property="og:url" content="{{ meta.url }}{{ page.url }}">
  <meta property="og:image" content="{{ meta.url }}{{ site.logo }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css?v={{ buildVersion }}">
  <link rel="icon" href="{{ site.logo }}" type="image/jpeg">
</head>
<body>

  {% include "partials/header.njk" %}

  {{ content | safe }}

  {% include "partials/footer.njk" %}

  {% include "partials/scripts.njk" %}
</body>
</html>
